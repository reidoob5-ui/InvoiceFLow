# Copy to .env.local. Never commit real credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoiceflow?schema=public"
APP_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
TENANCY_MODE="multi"

# Optional integrations (configure only when enabled)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Angola payments — ProxyPay connected to EMIS GPO (sandbox by default)
PROXYPAY_ENV="sandbox"
PROXYPAY_API_TOKEN=""
PROXYPAY_POS_ID=""
APP_URL="https://your-production-domain.example"

# International SaaS subscriptions — Paddle
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_PRO_MONTHLY=""
PADDLE_PRICE_PRO_YEARLY=""
PADDLE_PRICE_BUSINESS_MONTHLY=""
PADDLE_PRICE_BUSINESS_YEARLY=""
