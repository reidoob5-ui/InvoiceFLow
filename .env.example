# Copy to .env.local. Never commit real credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoiceflow?schema=public"
APP_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
TENANCY_MODE="multi"

# Optional integrations (configure only when enabled)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Angola payments — ProxyPay connected to EMIS GPO (sandbox by default)
PROXYPAY_ENV="sandbox"
PROXYPAY_API_TOKEN=""
PROXYPAY_POS_ID=""
APP_URL="https://your-production-domain.example"

# International SaaS subscriptions — Paddle
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_PRO_MONTHLY=""
PADDLE_PRICE_PRO_YEARLY=""
PADDLE_PRICE_BUSINESS_MONTHLY=""
PADDLE_PRICE_BUSINESS_YEARLY=""

# Scheduled job (Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"). Min. 16 random characters.
CRON_SECRET=""
# Automatic payment reminders to customers (opt-in, off by default)
AUTO_REMINDERS="false"

# --- Facturação electrónica AGT (nível plataforma; o NIF e a chave do contribuinte ficam por organização) ---
# Chave para cifrar em repouso a chave privada do contribuinte: openssl rand -base64 32
FISCAL_KEY_ENCRYPTION_KEY=
# Dados do produtor de software (certificação/validação junto da AGT)
AGT_PRODUCT_ID=
AGT_PRODUCT_VERSION=
AGT_SOFTWARE_VALIDATION_NUMBER=
# Chave RSA (PEM, \n escapados) do produtor para assinar softwareInfo
AGT_PRODUCER_PRIVATE_KEY=
# Basic Auth do produtor (pedir a produtores.dfe.dcrr.agt@minfin.gov.ao)
AGT_BASIC_USER=
AGT_BASIC_PASSWORD=
# Opcional: sobrepõe o URL (por defeito homologação sifphml / produção sifp conforme o perfil fiscal)
AGT_BASE_URL=
